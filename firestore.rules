rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/kadro/$(request.auth.uid); }
    function activeStaff() {
      return signedIn() && exists(staffPath())
        && get(staffPath()).data.aktif == true
        && get(staffPath()).data['e-posta'] == request.auth.token.email
        && get(staffPath()).data.rol in ['admin', 'stok'];
    }
    function admin() { return activeStaff() && get(staffPath()).data.rol == 'admin'; }
    function productPath(id) { return /databases/$(database)/documents/products/$(id); }
    function movementPath(id) { return /databases/$(database)/documents/stockMovements/$(id); }
    function validProduct(d) {
      return d.keys().hasAll(['code','name','unit','minStock','quantity','createdBy','createdAt','updatedBy','updatedAt'])
        && d.keys().hasOnly(['code','name','barcode','lot','expiry','unit','minStock','quantity','category','location','note','createdBy','createdAt','updatedBy','updatedAt','lastMovementId'])
        && d.code is string && d.code.size() > 0 && d.code.size() <= 64
        && d.name is string && d.name.size() > 0 && d.name.size() <= 160
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 40
        && d.minStock is int && d.minStock >= 0
        && d.quantity is int && d.quantity >= 0
        && d.get('barcode','') is string && d.get('barcode','').size() <= 128
        && d.get('lot','') is string && d.get('lot','').size() <= 128
        && d.get('expiry','') is string && d.get('expiry','').size() <= 10
        && d.get('category','') is string && d.get('category','').size() <= 80
        && d.get('location','') is string && d.get('location','').size() <= 80
        && d.get('note','') is string && d.get('note','').size() <= 400;
    }
    function validStaff(d) {
      return d.keys().hasAll(['aktif','e-posta','rol'])
        && d.keys().hasOnly(['aktif','e-posta','rol','adSoyad','updatedAt','updatedBy'])
        && d.aktif is bool && d['e-posta'] is string
        && d['e-posta'].size() <= 254 && d.get('adSoyad','') is string && d.get('adSoyad','').size() <= 120 && d.rol in ['admin','stok'];
    }
    function canAccess(feature) {
      return admin() || (activeStaff() && (!exists(/databases/$(database)/documents/accessPermissions/$(request.auth.uid)) || get(/databases/$(database)/documents/accessPermissions/$(request.auth.uid)).data.get(feature, false) == true));
    }
    function bloodAccess() { return admin() || (activeStaff() && exists(/databases/$(database)/documents/accessPermissions/$(request.auth.uid)) && get(/databases/$(database)/documents/accessPermissions/$(request.auth.uid)).data.get('bloodBank', false) == true); }
    match /sessionAudit/{id} {
      allow read: if admin();
      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly(['uid','email','event','createdAt'])
        && request.resource.data.keys().hasAll(['uid','email','event','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.event in ['SESSION_STARTED','SIGN_OUT_REQUESTED']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /permissionAudit/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['targetUid','targetEmail','actorUid','actorEmail','changes','createdAt'])
        && request.resource.data.keys().hasAll(['targetUid','targetEmail','actorUid','actorEmail','changes','createdAt'])
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.targetEmail is string
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.changes is map
        && request.resource.data.changes.size() > 0
        && request.resource.data.changes.keys().hasOnly(['inventory','stockMovements','stockCounts','suppliers','testLosses','labModules','bloodBank'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /accessPermissions/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['inventory','stockMovements','stockCounts','suppliers','testLosses','labModules','bloodBank']) && request.resource.data.keys().hasAll(['inventory','stockMovements','stockCounts','suppliers','testLosses','labModules']) && request.resource.data.inventory is bool && request.resource.data.stockMovements is bool && request.resource.data.stockCounts is bool && request.resource.data.suppliers is bool && request.resource.data.testLosses is bool && request.resource.data.labModules is bool && request.resource.data.get('bloodBank', false) is bool;
      allow delete: if admin();
    }
    match /kadro/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if admin() && validStaff(request.resource.data)
        && request.resource.data.get('updatedBy',request.auth.uid) == request.auth.uid;
      allow delete: if admin() && uid != request.auth.uid;
    }
    match /uiTextOverrides/{id} {
      allow read: if activeStaff();
      allow create, update: if admin() && id == 'global'
        && request.resource.data.keys().hasOnly(['values','updatedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['values','updatedBy','updatedAt'])
        && request.resource.data.values is map && request.resource.data.values.size() <= 250
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() && id == 'global';
    }
    match /uiSettings/{id} {
      allow read: if activeStaff();
      allow write: if admin() && id == 'global' && request.resource.data.keys().hasOnly(['labels','updatedBy','updatedAt']) && request.resource.data.keys().hasAll(['labels','updatedBy','updatedAt']) && request.resource.data.labels is map && request.resource.data.labels.size() <= 60 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    match /products/{id} {
      allow read: if canAccess('inventory');
      allow create: if canAccess('inventory') && validProduct(request.resource.data)
        && request.resource.data.quantity == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canAccess('inventory') && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (admin()
            && request.resource.data.quantity == resource.data.quantity
            && request.resource.data.get('lastMovementId','') == resource.data.get('lastMovementId',''))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity','lastMovementId','updatedAt','updatedBy'])
            && request.resource.data.lastMovementId is string
            && request.resource.data.lastMovementId.size() > 0
            && getAfter(movementPath(request.resource.data.lastMovementId)).data.productId == id
            && getAfter(movementPath(request.resource.data.lastMovementId)).data.after == request.resource.data.quantity
            && getAfter(movementPath(request.resource.data.lastMovementId)).data.before == resource.data.quantity
            && getAfter(movementPath(request.resource.data.lastMovementId)).data.uid == request.auth.uid)
        );
      allow delete: if admin() && resource.data.quantity == 0;
    }
    match /stockCounts/{id} {
      allow read: if canAccess('stockCounts');
      allow create: if canAccess('stockCounts')
        && request.resource.data.keys().hasAll(['productId','productName','systemQuantity','actualQuantity','difference','note','email','uid','createdAt'])
        && request.resource.data.keys().hasOnly(['productId','productName','systemQuantity','actualQuantity','difference','note','email','uid','createdAt'])
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.systemQuantity is int && request.resource.data.systemQuantity >= 0
        && request.resource.data.actualQuantity is int && request.resource.data.actualQuantity >= 0
        && request.resource.data.difference == request.resource.data.actualQuantity - request.resource.data.systemQuantity
        && request.resource.data.note is string && request.resource.data.note.size() <= 250
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.name == request.resource.data.productName
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.quantity == request.resource.data.systemQuantity;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actualQuantity','difference','note','updatedAt','updatedBy']) && request.resource.data.actualQuantity is int && request.resource.data.actualQuantity >= 0 && request.resource.data.difference == request.resource.data.actualQuantity - resource.data.systemQuantity && request.resource.data.note is string && request.resource.data.note.size() <= 250 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /suppliers/{id} {
      allow read: if canAccess('suppliers');
      allow create: if canAccess('suppliers')
        && request.resource.data.keys().hasAll(['name','taxNo','phone','email','contact','address','createdAt','createdBy'])
        && request.resource.data.keys().hasOnly(['name','taxNo','phone','email','contact','address','createdAt','createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.taxNo is string && request.resource.data.taxNo.size() <= 20
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
        && request.resource.data.address is string && request.resource.data.address.size() <= 250
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
        && request.resource.data.keys().hasAll(['name','taxNo','phone','email','contact','address','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.keys().hasOnly(['name','taxNo','phone','email','contact','address','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.taxNo is string && request.resource.data.taxNo.size() <= 20
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
        && request.resource.data.address is string && request.resource.data.address.size() <= 250
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if admin();
    }
    match /stockMovements/{id} {
      allow read: if canAccess('stockMovements');
      allow create: if canAccess('stockMovements')
        && request.resource.data.keys().hasAll(['productId','productName','type','quantity','before','after','note','email','uid','createdAt'])
        && request.resource.data.keys().hasOnly(['productId','productName','type','quantity','before','after','note','email','uid','createdAt','supplierId','supplierName','dispatchNo','dispatchDate','dispatchPath','unitCost','totalCost'])
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.type in ['IN','OUT','CAL','QC','WASTE','DISPOSAL']
        && request.resource.data.quantity is int && request.resource.data.quantity > 0
        && request.resource.data.before is int && request.resource.data.before >= 0
        && request.resource.data.after is int && request.resource.data.after >= 0
        && request.resource.data.note is string && request.resource.data.note.size() <= 250
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('supplierId','') is string
        && request.resource.data.get('supplierName','') is string
        && request.resource.data.get('dispatchNo','') is string
        && request.resource.data.get('dispatchDate','') is string
        && request.resource.data.get('dispatchPath','') is string
        && request.resource.data.get('dispatchNo','').size() <= 80
        && request.resource.data.get('dispatchPath','').size() <= 150
        && (request.resource.data.type != 'IN'
          || (request.resource.data.supplierId.size() > 0
            && request.resource.data.dispatchNo.size() > 0
            && request.resource.data.dispatchDate.size() == 10
            && exists(/databases/$(database)/documents/suppliers/$(request.resource.data.supplierId))
            && get(/databases/$(database)/documents/suppliers/$(request.resource.data.supplierId)).data.name == request.resource.data.supplierName))
        && (request.resource.data.type != 'OUT'
          || (request.resource.data.supplierId == '' && request.resource.data.supplierName == ''
            && request.resource.data.dispatchNo == '' && request.resource.data.dispatchDate == ''
            && request.resource.data.dispatchPath == ''))
        && (request.resource.data.type in ['IN','OUT'] || (request.resource.data.unitCost is number && request.resource.data.unitCost > 0 && request.resource.data.totalCost is number && request.resource.data.totalCost == request.resource.data.unitCost * request.resource.data.quantity && request.resource.data.get('supplierId','') == '' && request.resource.data.get('dispatchNo','') == '' && request.resource.data.get('dispatchPath','') == ''))
        && exists(productPath(request.resource.data.productId))
        && get(productPath(request.resource.data.productId)).data.name == request.resource.data.productName
        && get(productPath(request.resource.data.productId)).data.quantity == request.resource.data.before
        && getAfter(productPath(request.resource.data.productId)).data.quantity == request.resource.data.after
        && getAfter(productPath(request.resource.data.productId)).data.lastMovementId == id
        && (
          (request.resource.data.type == 'IN'
            && request.resource.data.after == request.resource.data.before + request.resource.data.quantity)
          || (request.resource.data.type in ['OUT','CAL','QC','WASTE','DISPOSAL']
            && request.resource.data.after == request.resource.data.before - request.resource.data.quantity)
        );
      allow update, delete: if false;
    }
    match /testLosses/{id} {
      allow read: if canAccess('testLosses');
      allow create: if canAccess('testLosses')
        && request.resource.data.keys().hasAll(['productId','productName','type','testCount','note','email','uid','createdAt'])
        && request.resource.data.keys().hasOnly(['productId','productName','type','testCount','note','email','uid','createdAt'])
        && request.resource.data.productId is string
        && exists(productPath(request.resource.data.productId))
        && request.resource.data.productName == get(productPath(request.resource.data.productId)).data.name
        && request.resource.data.type in ['CAL','QC','WASTE','DISPOSAL']
        && request.resource.data.testCount is int
        && request.resource.data.testCount > 0
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 250
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testCount','note','updatedAt','updatedBy']) && request.resource.data.testCount is int && request.resource.data.testCount > 0 && request.resource.data.note is string && request.resource.data.note.size() <= 250 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /labModules/{id} {
      allow read: if canAccess('labModules');
      allow create: if canAccess('labModules')
        && request.resource.data.category in ['kit','qc','device','order','capa','patient','audit']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().size() <= 20
        && request.resource.data.size() <= 10000
        && (request.resource.data.category != 'audit' || admin());
      allow update: if admin()
        && request.resource.data.category == resource.data.category
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() && resource.data.category != 'audit';
    }
    match /approvalRequests/{requestId} {
      allow get, list: if admin() || (activeStaff() && resource.data.requesterUid == request.auth.uid);
      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly(['type','title','description','status','requesterUid','requesterEmail','createdAt'])
        && request.resource.data.keys().hasAll(['type','title','description','status','requesterUid','requesterEmail','createdAt'])
        && request.resource.data.type in ['STOCK','MAINTENANCE','OTHER']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 1000
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
        && resource.data.status == 'PENDING'
        && resource.data.requesterUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','decidedBy','decidedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status','decisionNote','decidedBy','decidedAt'])
        && request.resource.data.status in ['APPROVED','REJECTED']
        && request.resource.data.decisionNote is string && request.resource.data.decisionNote.size() <= 500
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time;
      allow delete: if false;
    }
    match /bloodUnits/{unitId} {
      allow read: if bloodAccess();
      allow create: if bloodAccess() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'AVAILABLE';
      allow update: if bloodAccess() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy']) && request.resource.data.updatedBy == request.auth.uid && resource.data.status in ['AVAILABLE','QUARANTINED'] && request.resource.data.status in ['AVAILABLE','QUARANTINED','ISSUED','DISCARDED'];
      allow delete: if false;
    }
    match /bloodMovements/{movementId} {
      allow read: if bloodAccess();
      allow create: if bloodAccess() && request.resource.data.uid == request.auth.uid && request.resource.data.action in ['AVAILABLE','QUARANTINED','ISSUED','DISCARDED'];
      allow update, delete: if false;
    }
    match /controlledDocuments/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['title','category','revision','storagePath','createdBy','createdAt'])
        && request.resource.data.keys().hasAll(['title','category','revision','storagePath','createdBy','createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.category in ['procedure','instruction','form','manual','other']
        && request.resource.data.revision is string
        && request.resource.data.revision.size() <= 30
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('controlled-documents/[A-Za-z0-9_-]+[.](pdf|docx)')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /shiftHandovers/{id} {
      allow read: if activeStaff();
      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly(['date','shift','category','priority','title','note','status','createdBy','createdEmail','createdAt'])
        && request.resource.data.keys().hasAll(['date','shift','category','priority','title','note','status','createdBy','createdEmail','createdAt'])
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.shift in ['Gündüz','Gece','24 Saat']
        && request.resource.data.category in ['Genel','Cihaz','Stok','Kalite','Görev','Güvenlik']
        && request.resource.data.priority in ['NORMAL','IMPORTANT']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 1000
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if activeStaff()
        && resource.data.status == 'PENDING'
        && resource.data.createdBy != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','receivedBy','receivedEmail','receivedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status','receivedBy','receivedEmail','receivedAt'])
        && request.resource.data.status == 'RECEIVED'
        && request.resource.data.receivedBy == request.auth.uid
        && request.resource.data.receivedEmail == request.auth.token.email
        && request.resource.data.receivedAt == request.time;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','note','editedBy','editedEmail','editedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 1000
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.editedEmail == request.auth.token.email
        && request.resource.data.editedAt == request.time;
      allow delete: if false;
    }
    match /dutyRequests/{requestId} {
      allow read: if admin() || (activeStaff() && resource.data.requesterUid == request.auth.uid);
      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly(['type','from','to','targetUid','targetEmail','reason','status','requesterUid','requesterEmail','createdAt'])
        && request.resource.data.keys().hasAll(['type','from','to','targetUid','targetEmail','reason','status','requesterUid','requesterEmail','createdAt'])
        && request.resource.data.type in ['LEAVE','SWAP']
        && request.resource.data.from is string && request.resource.data.from.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.to is string && request.resource.data.to.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.from <= request.resource.data.to
        && request.resource.data.targetUid is string && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetEmail is string && request.resource.data.targetEmail.size() <= 254
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
        && resource.data.status == 'PENDING'
        && resource.data.requesterUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','decidedBy','decidedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status','decisionNote','decidedBy','decidedAt'])
        && request.resource.data.status in ['APPROVED','REJECTED']
        && request.resource.data.decisionNote is string && request.resource.data.decisionNote.size() <= 500
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time;
      allow delete: if false;
    }
    match /dutyRoster/{entryId} {
      allow read: if admin() || (activeStaff() && resource.data.personUid == request.auth.uid);
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['personUid','personName','date','shift','start','end','note','createdBy','createdAt'])
        && request.resource.data.keys().hasAll(['personUid','personName','date','shift','start','end','note','createdBy','createdAt'])
        && request.resource.data.personUid is string
        && request.resource.data.personUid.size() > 0
        && request.resource.data.personName is string
        && request.resource.data.personName.size() <= 254
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.shift in ['Gündüz','Gece','24 Saat','İzin']
        && request.resource.data.start is string
        && request.resource.data.start.matches('[0-2][0-9]:[0-5][0-9]')
        && request.resource.data.end is string
        && request.resource.data.end.matches('[0-2][0-9]:[0-5][0-9]')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if admin();
    }
    match /productCategories/{id} {
      allow read: if activeStaff();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['name','updatedBy','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /productUnits/{id} {
      allow read: if activeStaff();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['name','updatedBy','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /movementNotes/{id} {
      allow read: if activeStaff();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['name','updatedBy','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 250 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /productLocations/{id} {
      allow read: if activeStaff();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['name','updatedBy','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
