rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/kadro/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/kadro/$(request.auth.uid)).data.aktif == true
        && firestore.get(/databases/(default)/documents/kadro/$(request.auth.uid)).data['e-posta'] == request.auth.token.email
        && firestore.get(/databases/(default)/documents/kadro/$(request.auth.uid)).data.rol in ['admin', 'stok'];
    }
    match /dispatch-notes/{fileName} {
      allow read: if activeStaff();
      allow create: if activeStaff()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf','image/jpeg','image/png','image/webp']
        && fileName.matches('[A-Za-z0-9_-]+[.](pdf|jpg|png|webp)')
        && request.resource.metadata.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /device-inserts/{deviceId}/{fileName} {
      allow read: if activeStaff();
      allow create: if activeStaff()
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','image/jpeg','image/png'];
      allow delete: if activeStaff()
        && firestore.get(/databases/(default)/documents/kadro/$(request.auth.uid)).data.rol == 'admin';
      allow update: if false;
    }
    match /controlled-documents/{fileName} {
      allow read: if activeStaff()
        && firestore.get(/databases/(default)/documents/kadro/$(request.auth.uid)).data.rol == 'admin';
      allow create: if activeStaff()
        && firestore.get(/databases/(default)/documents/kadro/$(request.auth.uid)).data.rol == 'admin'
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf','application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && fileName.matches('[A-Za-z0-9_-]+[.](pdf|docx)');
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
